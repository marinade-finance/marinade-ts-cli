{
  "description": "Marinade typescript-based SDK for CLI",
  "license": "ISC",
  "author": "Marinade.Finance",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "tsc --build --clean",
    "test": "anchor test",
    "_test": "jest $FILE",
    "test:no-anchor": "jest --globalSetup='' $FILE",
    "marinade": "pnpm cli",
    "cli": "ts-node ./packages/marinade-ts-cli/src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check",
    "fix": "pnpm lint:fix && pnpm format",
    "prepare": "husky",
    "publish:test": "pnpm build && pnpm test && pnpm publish -r --dry-run",
    "publish:all": "pnpm build && pnpm test && pnpm publish -r"
  },
  "devDependencies": {
    "@jest/globals": "30.1.2",
    "@marinade.finance/eslint-config": "1.2.1",
    "@types/bn.js": "5.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.7",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "expect": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "pnpm": {
    "overrides": {
      "semver@<6.3.1": "6.3.1",
      "micromatch@<4.0.8": "4.0.8",
      "base-x@<3.0.11": "3.0.11",
      "base-x@4.0.0": "4.0.1",
      "base-x@5.0.0": "5.0.1",
      "@babel/helpers@<7.26.10": "7.27.1",
      "@babel/runtime@<7.26.10": "7.27.1"
    },
    "onlyBuiltDependencies": [
      "bigint-buffer",
      "bufferutil",
      "node-hid",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
