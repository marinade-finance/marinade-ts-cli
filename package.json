{
  "description": "Marinade typescript-based SDK for CLI",
  "license": "ISC",
  "author": "Marinade.Finance",
  "packageManager": "pnpm@11.0.4",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "tsc --build --clean",
    "test": "anchor test",
    "_test": "jest $FILE",
    "test:no-anchor": "jest --globalSetup='' $FILE",
    "marinade": "pnpm cli",
    "cli": "ts-node ./packages/marinade-ts-cli/src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check",
    "fix": "pnpm lint:fix && pnpm format",
    "prepare": "husky",
    "publish:test": "pnpm build && pnpm test && pnpm publish -r --dry-run",
    "publish:all": "pnpm build && pnpm test && pnpm publish -r"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@marinade.finance/eslint-config": "1.3.5",
    "@types/bn.js": "5.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.7",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "expect": "^29.7.0",
    "prettier": "^3.8.4",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
